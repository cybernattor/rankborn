[sub_resource type="Shader" id="Shader_scope"]
code = "shader_type canvas_item;

void fragment() {
	vec2 uv = SCREEN_UV;
	vec2 center = vec2(0.5, 0.5);
	vec2 diff = uv - center;
	diff.x *= SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x;
	float dist = length(diff);
	float radius = 0.18;
	float edge = 0.015;
	float alpha = smoothstep(radius - edge, radius + edge, dist);
	COLOR = vec4(0.0, 0.0, 0.0, alpha * 0.88);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_scope"]
